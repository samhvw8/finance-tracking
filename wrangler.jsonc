{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "finance-tracking",
  "main": "src/worker.js",
  "compatibility_date": "2025-06-01",
  // Keep the *.workers.dev URL alive as a fallback alongside the custom domain.
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // SPA: serve index.html for client-side routes (TanStack Router).
    "not_found_handling": "single-page-application",
    // Run the Worker FIRST for these paths so browser navigations to /img/ and
    // /api/ reach the Worker instead of being swallowed by the SPA fallback.
    "run_worker_first": ["/api/*", "/img/*"]
  },
  "vars": {
    // The Google Spreadsheet (file) ID that holds all tabs:
    //   "Giao Dịch", "Giao Dịch Investment", "Setup Finanace", "Investment Account".
    // Public (non-secret). Replace before first deploy.
    "SHEET_ID": "1mmENKogRPN-tNqPET8NUJsEpFR_zoldxfTpkLl43-tY"
  },
  // Image storage. The Worker uploads receipts here and serves them at /img/<key>
  // (public, unguessable UUID keys) so =IMAGE(url) can render them in the sheet.
  "r2_buckets": [
    { "binding": "IMAGES", "bucket_name": "finance-tracking-images" }
  ],
  // Brute-force protection: throttle /api by client IP (30 requests / 60s).
  "ratelimits": [
    { "name": "API_LIMITER", "namespace_id": "1001", "simple": { "limit": 30, "period": 60 } }
  ],
  // Custom domain — claimed by this Worker (removed from the old Pages project first).
  "routes": [
    { "pattern": "finance-tracking.3cxo.work", "custom_domain": true }
  ]
  // Secrets (set via `wrangler secret put`, never committed):
  //   APP_PASSWORD            -> shared access password
  //   GOOGLE_SERVICE_ACCOUNT  -> full service-account JSON (.secrets/sa-key.json)
}
